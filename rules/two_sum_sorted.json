{
  "problem": "two_sum_sorted",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.25,
      "params": { "testset_dir": "tests/two_sum/" }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.25,
      "params": { "required": "O(N)", "input_type": "two_sum", "sizes": [10, 100, 1000] }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.10,
      "params": { "flags": "-Wall -Wextra -Werror -std=c11" }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.10,
      "params": { "max_cyclomatic": 8, "max_function_length": 40 }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.10,
      "params": { "expect_helpers": true, "min_functions": 2 }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.10,
      "params": {
        "custom_cases": [
          { "input": "5\n1 2 3 4 5\n100\n", "expected": "-1", "label": "target not present in array" },
          { "input": "2\n-3 3\n0\n", "expected": "0 1", "label": "negative values summing to zero" },
          { "input": "1\n5\n5\n", "expected": "-1", "label": "array of length 1 (requires two numbers)" }
        ]
      }
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.10,
      "params": { "model": "llama-3.3-70b-versatile", "temperature": 0, "seed": 42 }
    }
  ]
}

