{
  "problem": "reverse_array",
  "time_limit_s": 2,
  "memory_limit_mb": 128,
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.30,
      "params": { "testset_dir": "tests/reverse/" }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.15,
      "params": { "flags": "-Wall -Wextra -std=c11" }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.15,
      "params": { "max_cyclomatic": 10, "max_function_length": 50 }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.10,
      "params": { "expect_helpers": true, "min_functions": 2 }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.15,
      "params": { "required": "O(N)", "sizes": [10, 100, 1000] }
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.15,
      "params": { "model": "llama-3.3-70b-versatile", "temperature": 0, "seed": 42 }
    }
  ]
}

